:root {
  --fg: rgb(55 55 55);
  --bg: rgb(231 231 225);
  --fgh: rgb(255 255 255 / 37%);
  --fg2: rgb(137 137 100);
  --fg230: rgb(137 137 100 / 30%);
  --fgc: rgb(25 25 25);
  --fgr: rgb(125, 35, 35);
  --fgb: rgb(35 35 125);
  --fgp: rgb(125 35 125);
  --pad: 1.25rem;
  --hpad: 0.7rem;
  --margin: 1rem;
}

::selection {
  color: var(--fg);
  background-color: var(--fg2);
}

.bodoni-moda-sc-titlefont {
  font-family: "Bodoni Moda SC", serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal;
  text-transform: uppercase;
  letter-spacing: 0.1125rem;
}

.baskervville-bodyfont {
  font-family: "Baskervville", serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal;
}

.cormorant-sc-buttonfont {
  font-family: "Cormorant SC", serif;
  font-weight: 500;
  font-style: normal;
}

.vertical-space {
  padding: var(--hpad) 0;
}

.max-halfwidth {
  margin: 0 7rem 0 7rem;
}

code {
  background-color: var(--fg);
  color: var(--bg);
  border-radius: 0.5rem;
  padding: 0 0.5rem 0 0.5rem;
}

body {
  margin: 0;
  text-align: center;
  background-color: var(--bg);

  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.parent-height-grow {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.child-height-grow {
  flex: 1;
}

:is(h1, h2, h3, h4, h5, h6) {
  font-family: "Bodoni Moda SC", serif;
  font-optical-sizing: auto;
  font-weight: 400;
  font-style: normal;
  text-transform: uppercase;
  text-align: center;
  text-decoration: underline;
  text-decoration-thickness: 0.15rem;
  text-underline-offset: 0.7rem;
  padding-bottom: 0.5rem;
}

nav {
  padding: var(--pad) 0 0 0;
  display: flexbox;
  justify-content: space-evenly;
  align-items: center;
}

nav > a {
  flex-grow: 1;
  padding: var(--pad);
  color: var(--fg);
  font-weight: 500;
  text-decoration: none;
  transition:
    background-color 150ms ease,
    color 150ms ease;
}

nav > a:hover {
  background-color: var(--fgh);
  color: var(--fg2);
}

main {
  padding-top: 2rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

main a {
  color: var(--fg);
  text-decoration-color: var(--fg);
  text-decoration-thickness: 0.07em;
  text-underline-offset: 0.2em;
  transition: color 150ms ease;
}

@keyframes logo-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.button-list {
  margin-top: var(--pad);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  align-content: stretch;
  min-width: 33vw;
  background-color: var(--fg);
}

.button-list a {
  color: var(--fgh);
  text-align: left;
  font-size: 0.8em;
  text-decoration: none;
  padding: var(--pad);
  border-bottom: var(--fgh) solid 0.05em;
  /* border-image: linear-gradient(
      to right,
      var(--fg) 0%,
      var(--fgh) 30%,
      var(--fgh) 70%,
      var(--fg) 100%
    )
    1; */
  transition:
    background-color 150ms ease,
    color 150ms ease;
}

.ar:hover {
  color: var(--bg);
  background-color: var(--fgr);
}

.ab:hover {
  color: var(--bg);
  background-color: var(--fgb);
}

.ap:hover {
  color: var(--bg);
  background-color: var(--fgp);
}

.indexbody {
  margin-top: var(--hpad);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  align-content: stretch;
  max-width: 33vw;
  background-color: var(--fg);
  line-height: 1.25rem;
}

.indexbody p {
  padding: 0 var(--pad);

  font-size: 0.8em;
  color: var(--fgh);
}

.indexbody code {
  font-size: 1em;
  background-color: var(--fgh);
  color: var(--fg);
  white-space: pre-wrap;
  overflow-wrap: break-word;

  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

.italic {
  font-style: italic;
}

.landing-img {
  width: min(15rem, 65vw);
  height: auto;
}

figure {
  border: var(--fg) solid 0.05em;
  max-width: fit-content;
}

figcaption {
  font-style: italic;
  opacity: 52.5%;
}

.center {
  display: flex;
  justify-content: center;
}

.height100 {
  height: 100%;
}

a:hover {
  color: var(--bg);
  background-color: var(--fg);
}

a:focus-visible {
  outline: 3px solid var(--fg2);
  outline-offset: 3px;
  border-radius: 0.2rem;
}

.noselect {
  -webkit-touch-callout: none; /* iOS Safari */
  -webkit-user-select: none; /* Safari */
  -khtml-user-select: none; /* Konqueror HTML */
  -moz-user-select: none; /* Old versions of Firefox */
  -ms-user-select: none; /* Internet Explorer/Edge */
  user-select: none; /* Non-prefixed version, currently
                                  supported by Chrome, Edge, Opera and Firefox */
}
